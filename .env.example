# Karduno Self-Hosted
# Run easy-install.sh (Unix) or easy-install.ps1 (Windows) for guided setup.
# For manual configuration, copy this file to .env and fill in the values below.
# Application images always use latest.

# Two different DNS names pointing to your server, without https://, ports, or paths.
PORTAL_DOMAIN=karduno-points.example.com
ADMIN_DOMAIN=admin.karduno-points.example.com

# Contact email for automatic HTTPS certificates.
ACME_EMAIL=admin@example.com

# The installer generates the database password and JWT key in these files:
#   secrets/postgres_password
#   secrets/jwt_secret
# They are not .env variables. Keep the files and include them in your backup.

# Initial administrator, created only if no staff account exists yet.
# Choose a unique password with at least 12 characters.
# Keep passwords in single quotes, including values containing $ or #.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=''

# Email delivery (registration, verification, and other mail) is configured in the administration interface, not in this file.
